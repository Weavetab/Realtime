{
  "name": "@weavetab/plugin-realtime",
  "version": "0.2.0",
  "description": "Causal age/proximity tags for browser_map, 60Hz in-page reflex rules, canvas entity sampling and a bounded click loop for Weavetab.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "weavetab.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "preflight": "weavetab preflight",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@weavetab/sdk": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "chrome-remote-interface": "^0.33.2",
    "typescript": "^5.5.0"
  },
  "keywords": [
    "weavetab",
    "weavetab-plugin",
    "cdp",
    "canvas",
    "browser-automation"
  ],
  "author": {
    "name": "fy2ne",
    "url": "https://fy2ne.me"
  },
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/Weavetab/Realtime.git" },
  "bugs": { "url": "https://github.com/Weavetab/Realtime/issues" },
  "homepage": "https://github.com/Weavetab/Realtime#readme",
  "engines": {
    "node": ">=18.0.0"
  }
}
