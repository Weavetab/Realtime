{
  "$schema": "https://weavetab.dev/schema/plugin.json",
  "name": "@weavetab/plugin-realtime",
  "displayName": "Realtime",
  "version": "0.1.0",
  "description": "Causal tags for browser_map, in-page reflex rules, canvas entity sampling and a bounded click loop for Weavetab.",
  "entry": "dist/index.js",
  "engines": {
    "weavetab": ">=2.6.0",
    "node": ">=18.0.0"
  },
  "environments": ["mcp"],
  "authors": [{ "name": "fy2ne", "role": "Author", "url": "https://fy2ne.me" }],
  "license": "Apache-2.0",
  "tags": ["Canvas", "Games", "CDP", "Automation", "Community"],
  "defaultConfig": { "causalWindowMs": 4000 },
  "links": { "github": "https://github.com/Weavetab/Realtime", "npm": "https://www.npmjs.com/package/@weavetab/plugin-realtime" },
  "permissions": {
    "cdp": {
      "evaluate": true,
      "input": true,
      "reason": "Injects a MutationObserver, canvas draw recorder and reflex loop into the page, and sends real mouse clicks for realtime_autopilot."
    },
    "tools": {
      "add": true,
      "reason": "Registers realtime_canvas, realtime_reflex, realtime_autopilot and realtime_status."
    },
    "hooks": {
      "onBeforeAction": true,
      "onAfterAction": true,
      "reason": "Installs the page probe before any tool runs and appends {new ...} tags to browser_map output."
    },
    "network": {
      "hosts": ["127.0.0.1", "localhost"],
      "reason": "realtime_autopilot can POST candidates to a model_url the caller supplies (meant for a local OpenAI-compatible server)."
    }
  },
  "tools": [
    {
      "name": "realtime_canvas",
      "description": "Sample what a 2D canvas game draws: entities with signature, bbox and px/frame velocity.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": { "type": "string", "enum": ["sample", "attach", "detach"], "default": "sample" },
          "frames": { "type": "integer", "minimum": 2, "maximum": 15, "description": "frames to watch, default 6" }
        }
      }
    },
    {
      "name": "realtime_reflex",
      "description": "Register, list or remove rules that run inside the page every animation frame.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": { "type": "string", "enum": ["add", "remove", "list", "clear"], "default": "add" },
          "id": { "type": "string" },
          "when": {
            "type": "object",
            "properties": {
              "selector": { "type": "string" },
              "text": { "type": "string" },
              "only_new": { "type": "boolean" },
              "enabled": { "type": "boolean" },
              "canvas": {
                "type": "object",
                "properties": {
                  "names": { "type": "object", "additionalProperties": { "type": "string" } },
                  "js": { "type": "string" }
                },
                "required": ["names", "js"]
              }
            }
          },
          "do": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["click", "click_xy", "key", "js"] },
              "x": { "type": "number" },
              "y": { "type": "number" },
              "key": { "type": "string" },
              "hold_ms": { "type": "number" },
              "code": { "type": "string" }
            },
            "required": ["type"]
          },
          "cooldown_ms": { "type": "number" },
          "max_hits": { "type": "number" },
          "ttl_ms": { "type": "number" },
          "stop_selector": { "type": "string" }
        }
      }
    },
    {
      "name": "realtime_autopilot",
      "description": "Bounded click loop for short UI sub-goals, ranked by label/goal word overlap and element recency.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "goal": { "type": "string", "minLength": 3 },
          "max_steps": { "type": "integer", "minimum": 1, "maximum": 25 },
          "stop_when_selector": { "type": "string" },
          "stop_when_text": { "type": "string" },
          "stop_when_url": { "type": "string" },
          "avoid_labels": { "type": "string" },
          "model_url": { "type": "string", "format": "uri" },
          "model": { "type": "string" },
          "model_timeout_ms": { "type": "number" }
        },
        "required": ["goal"]
      }
    },
    {
      "name": "realtime_status",
      "description": "Probe, canvas recorder and reflex state for the current page; wait_ms blocks until active reflexes finish.",
      "inputSchema": {
        "type": "object",
        "properties": { "wait_ms": { "type": "number" } }
      }
    }
  ]
}
